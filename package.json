    "react": "19.3.1",
    "react-colorful": "5.8.1",
    "react-dom": "19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
