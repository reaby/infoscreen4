{
  "name": "infoscreen4",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env server.ts",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "start": "cross-env NODE_ENV=production tsx --env-file=.env server.ts",
