# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# TLS certificates
key.pem
cert.pem

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# github pages docs
docs/_site
docs/.jekyll-cache
docs/Gemfile.lock

# user accounts and login sessions (runtime data)
data/sessions.json
data/users.json
